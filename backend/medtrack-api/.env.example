# MedTrack - AVS Backend Environment Variables Example
# Duplicate this file as .env or export these in your operating system / IDE / Railway

# Server Port (Railway automatically sets PORT; SERVER_PORT is local fallback)
PORT=8080
SERVER_PORT=8080

# Database Configuration (MySQL / MariaDB)
# Local MariaDB / MySQL:
DB_URL=jdbc:mariadb://localhost:3306/medtrack_db?useSSL=false&timezone=UTC
DB_USERNAME=medtrack_user
DB_PASSWORD=CHANGE_ME
# On Railway with MySQL addon, Railway automatically provides:
# MYSQLHOST, MYSQLPORT, MYSQLUSER, MYSQLPASSWORD, MYSQLDATABASE
# The backend will automatically construct the JDBC URL if DB_URL is not set.

# CORS Allowed Origins (Comma-separated list of allowed frontend origins)
# For local development: http://localhost:5173
# For production on Vercel: https://your-medtrack-app.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Frontend OAuth2 Callback Redirect URI
# Local: http://localhost:5173/auth/callback
# Production: https://your-medtrack-app.vercel.app/auth/callback
OAUTH2_REDIRECT_URI=http://localhost:5173/auth/callback

# Initial Passwords for Local Development Seeding (Optional)
MEDTRACK_DEV_ADMIN_PASSWORD=CHANGE_ME
MEDTRACK_DEV_SUPERVISOR_PASSWORD=CHANGE_ME
MEDTRACK_DEV_STAFF_PASSWORD=CHANGE_ME

# JWT Security Configuration (HS384 requires at least 384 bits / 48 bytes Base64-encoded, 64 chars)
JWT_SECRET=CHANGE_ME_SECURE_RANDOM_KEY_AT_LEAST_48_BYTES_BASE64
JWT_EXPIRATION_MS=86400000

# Google OAuth2 Client Configuration (Optional)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME_GOOGLE_CLIENT_SECRET

# Admin Email Allowlist for Google OAuth Provisioning (comma-separated, exact match)
MEDTRACK_ADMIN_EMAILS=admin@hospital.org

# Cloud AI Provider Configuration (Optional)
# Supported providers: GEMINI, OPENAI
AI_PROVIDER=GEMINI
AI_API_KEY=CHANGE_ME_AI_API_KEY
AI_MODEL=gemini-3.5-flash-lite
AI_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3.8-flash
AI_MAX_RETRIES=1
AI_RETRY_BACKOFF_MS=500
# AI_API_BASE_URL=https://generativelanguage.googleapis.com
AI_CONNECT_TIMEOUT_MS=5000
AI_READ_TIMEOUT_MS=30000
