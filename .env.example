# ==============================================================================
# MedTrack – AVS: Environment Variables Template
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Vercel / Local Vite)
# ------------------------------------------------------------------------------
# In development (localhost): Leave blank or unset to use Vite's local dev proxy
# In production (Vercel): Set to your deployed Railway backend URL (NO trailing slash)
VITE_API_BASE_URL=https://your-medtrack-api.up.railway.app

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (Railway / Local Spring Boot)
# ------------------------------------------------------------------------------
# Server Port (Railway automatically injects PORT; SERVER_PORT is local fallback)
PORT=8080
SERVER_PORT=8080

# Database Configuration (MySQL / MariaDB)
# Local:
DB_URL=jdbc:mariadb://localhost:3306/medtrack_db?useSSL=false&timezone=UTC
DB_USERNAME=medtrack_user
DB_PASSWORD=CHANGE_ME
# On Railway with MySQL addon, Railway automatically injects:
# MYSQLHOST, MYSQLPORT, MYSQLUSER, MYSQLPASSWORD, MYSQLDATABASE
# The backend will automatically construct the JDBC URL if DB_URL is not set.

# CORS Allowed Origins (Comma-separated list of deployed frontend origins)
# In production: Set to your exact Vercel URL
CORS_ALLOWED_ORIGINS=https://your-medtrack-app.vercel.app

# Frontend OAuth2 Callback Redirect URI
# In production: Set to https://your-medtrack-app.vercel.app/auth/callback
OAUTH2_REDIRECT_URI=https://your-medtrack-app.vercel.app/auth/callback

# Demonstration Data Seeding (Fail-Safe: default false in production; set to true in local development)
MEDTRACK_SEED_DEMO_DATA=false

# Initial Demo Passwords for Seeding (Optional)
MEDTRACK_DEV_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
MEDTRACK_DEV_SUPERVISOR_PASSWORD=CHANGE_ME_SUPERVISOR_PASSWORD
MEDTRACK_DEV_STAFF_PASSWORD=CHANGE_ME_STAFF_PASSWORD

# JWT Signing Secret (HS384 requires >= 48 bytes / 384 bits Base64-encoded)
# Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_BASE64_KEY_AT_LEAST_48_BYTES
JWT_EXPIRATION_MS=86400000

# Google OAuth2 Client Configuration (Optional)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME_GOOGLE_CLIENT_SECRET

# Admin Email Allowlist for Google OAuth (comma-separated, exact match)
MEDTRACK_ADMIN_EMAILS=admin@hospital.org

# Cloud AI Provider Configuration (Optional)
AI_PROVIDER=GEMINI
AI_API_KEY=CHANGE_ME_GEMINI_API_KEY
AI_MODEL=gemini-3.8-flash
AI_CONNECT_TIMEOUT_MS=5000
AI_READ_TIMEOUT_MS=30000
