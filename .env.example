# MedTrack - AVS Backend Environment Variables Example
# Duplicate this file as .env or export these in your operating system / IDE

# Database Configuration (MySQL / MariaDB)
DB_URL=jdbc:mariadb://localhost:3306/medtrack_db?useSSL=false&timezone=UTC
DB_USERNAME=medtrack_user
DB_PASSWORD=CHANGE_ME

# Initial Passwords for Local Development Seeding (Optional)
MEDTRACK_DEV_ADMIN_PASSWORD=CHANGE_ME
MEDTRACK_DEV_SUPERVISOR_PASSWORD=CHANGE_ME
MEDTRACK_DEV_STAFF_PASSWORD=CHANGE_ME

# JWT Security Configuration (HS384 requires at least 384 bits / 48 bytes Base64-encoded, 64 chars)
JWT_SECRET=CHANGE_ME_SECURE_RANDOM_KEY_AT_LEAST_48_BYTES_BASE64
JWT_EXPIRATION_MS=86400000

# Google OAuth2 Client Configuration (Optional)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME_GOOGLE_CLIENT_SECRET

# Admin Email Allowlist for Google OAuth Provisioning (comma-separated, exact match)
MEDTRACK_ADMIN_EMAILS=admin@hospital.org

# Server Port
SERVER_PORT=8080

# Cloud AI Provider Configuration (Phase 20.1 - Optional)
# Supported providers: GEMINI, OPENAI
AI_PROVIDER=GEMINI
AI_API_KEY=CHANGE_ME_AI_API_KEY
AI_MODEL=gemini-3.8-flash
# AI_API_BASE_URL=https://generativelanguage.googleapis.com
AI_CONNECT_TIMEOUT_MS=5000
AI_READ_TIMEOUT_MS=30000
